# 4N DEV Core - VPS Docker environment
# Copy this file to .env on the VPS and replace every placeholder with real values.
# NEVER commit the real .env file.

POSTGRES_PASSWORD=replace-with-a-long-random-postgres-password

CORE_API_KEY=replace-with-a-secure-bootstrap-api-key
CORE_API_KEY_PLAN=pro
CORE_API_KEY_INITIAL_CREDITS=500
CORE_ADMIN_SECRET=replace-with-a-long-random-admin-secret

OPENAI_API_KEY=replace-with-your-openai-api-key

PAPI_API_KEY=replace-with-papi-api-key
PAPI_WEBHOOK_SECRET=replace-with-papi-webhook-secret
PAPI_API_URL=https://app.papi.mg/engine/api/payment-links
PUBLIC_API_URL=https://your-domain.example
PAPI_SUCCESS_URL=
PAPI_FAILURE_URL=
PAPI_NOTIFICATION_URL=
PAPI_VALID_DURATION_HOURS=24
PAPI_TEST_MODE=false

CORE_PAYMENT_WEBHOOK_SECRET=
INTERNATIONAL_PAYMENT_API_URL=https://api.zopayo.com/operation/
INTERNATIONAL_PAYMENT_API_KEY=
INTERNATIONAL_PAYMENT_WEBHOOK_SECRET=
INTERNATIONAL_SUCCESS_URL=
INTERNATIONAL_FAILURE_URL=
