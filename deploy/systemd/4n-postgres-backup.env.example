# 4N DEV Core external PostgreSQL backup configuration
# Copy to /etc/4n-dev-core/backup.env on the VPS.
# Protect this file with chmod 600.
#
# S3-compatible storage is supported. For AWS S3, leave AWS_ENDPOINT_URL empty.
S3_BUCKET=replace-with-your-backup-bucket
S3_PREFIX=4n-dev-core/postgres
AWS_ENDPOINT_URL=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=replace-with-backup-access-key
AWS_SECRET_ACCESS_KEY=replace-with-backup-secret-key
