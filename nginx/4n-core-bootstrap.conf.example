# Bootstrap NGINX configuration for the first VPS deployment.
# Use this before the Let's Encrypt certificate exists.
# Replace api.your-domain.example with the real API domain.

server {
    listen 80;
    listen [::]:80;

    server_name api.your-domain.example;

    client_max_body_size 25m;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # Keep readiness checks short and prevent stale proxy responses.
    location = /health/ready {
        proxy_pass http://core:3001/health/ready;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_send_timeout 5s;
        proxy_read_timeout 5s;
        proxy_no_cache 1;
        add_header Cache-Control "no-store" always;
    }

    location / {
        proxy_pass http://core:3001;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }
}
