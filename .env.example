# 4N DEV Core environment configuration
# Copy this file to .env for local development.
# Never commit real secrets.

# Server
PORT=3001

# PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DB_POOL_MAX=10

# Core API bootstrap/admin
CORE_API_KEY=replace-with-a-secure-bootstrap-api-key
CORE_API_KEY_PLAN=pro
CORE_API_KEY_INITIAL_CREDITS=500
CORE_ADMIN_SECRET=replace-with-a-long-random-secret

# AI provider
OPENAI_API_KEY=replace-with-your-openai-api-key

# PAPI payment provider
PAPI_API_KEY=replace-with-papi-api-key
PAPI_WEBHOOK_SECRET=replace-with-papi-webhook-secret
PAPI_API_URL=https://app.papi.mg/engine/api/payment-links
PUBLIC_API_URL=https://your-domain.example
PAPI_SUCCESS_URL=
PAPI_FAILURE_URL=
PAPI_NOTIFICATION_URL=
PAPI_VALID_DURATION_HOURS=24
PAPI_TEST_MODE=false

# Legacy/optional payment integration placeholders
CORE_PAYMENT_WEBHOOK_SECRET=replace-if-used
INTERNATIONAL_PAYMENT_API_URL=
INTERNATIONAL_PAYMENT_API_KEY=
