# 4N DEV Core environment configuration
# Copy to .env on the server and replace every placeholder.
# Never commit real secrets.

# Server
NODE_ENV=production
PORT=3001
CORE_DATA_DIR=/var/lib/4ndev/core-data

# PostgreSQL (required by docker-compose.yml)
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
DATABASE_URL=postgresql://4ncore:replace-with-a-long-random-database-password@postgres:5432/4ncore
DB_POOL_MAX=10

# Core API bootstrap/admin
CORE_API_KEY=replace-with-a-secure-bootstrap-api-key
CORE_API_KEY_PLAN=pro
CORE_API_KEY_INITIAL_CREDITS=500
CORE_ADMIN_SECRET=replace-with-a-long-random-secret

# AI provider
OPENAI_API_KEY=

# PAPI payment provider
PAPI_API_KEY=
PAPI_WEBHOOK_SECRET=
PAPI_API_URL=https://app.papi.mg/engine/api/payment-links
PUBLIC_API_URL=https://your-domain.example
PAPI_SUCCESS_URL=
PAPI_FAILURE_URL=
PAPI_NOTIFICATION_URL=
PAPI_VALID_DURATION_HOURS=24
PAPI_TEST_MODE=false

# Zopayo: confirm exact environment variable names in its adapter before configuring.
# Do not paste live keys into this example file.

# Legacy/optional payment integration placeholders
CORE_PAYMENT_WEBHOOK_SECRET=
INTERNATIONAL_PAYMENT_API_URL=
INTERNATIONAL_PAYMENT_API_KEY=
